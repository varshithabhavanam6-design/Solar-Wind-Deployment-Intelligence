# Copy this file to .env and adjust if needed.
# No API keys are required for Milestone 1 — NASA POWER, Open-Elevation,
# and the public Overpass API are all free/keyless endpoints.

# Comma-separated list of frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Timeouts (seconds) for outbound calls — increase if you're on a slow connection.
NASA_POWER_TIMEOUT=12
ELEVATION_TIMEOUT=10
OSM_TIMEOUT=15

# Search radius (meters) for OpenStreetMap proximity queries.
OSM_SEARCH_RADIUS_METERS=3000

# Advanced: override these only if you want to point at a mirror/self-hosted
# instance. Leave commented to use the public defaults.
# NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
# ELEVATION_BASE_URL=https://api.open-elevation.com/api/v1/lookup
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Comma-separated fallback Overpass mirrors, tried in order if the primary
# instance rejects the request (e.g. HTTP 406) or is unavailable.
# OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# Overpass's public instances reject requests without a real User-Agent
# (this is what causes HTTP 406). Change the contact email if you like.
# OVERPASS_USER_AGENT=SolarWindDeploymentIntelligence/1.0 (Milestone1; contact: varshithabhavanam6@gmail.com)
